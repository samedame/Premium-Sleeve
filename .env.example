# Discord webhook for alerts (required in production)
DISCORD_WEBHOOK_URL=

# Allocated capital. Deliberately unset by default: with no value the
# bot alerts UNSIZED (trade shown, no contract count).
# Measured floor at SPY ~770 is $20,000 -- below that it sizes to zero.
ACCOUNT_CAPITAL_FOR_SIZING=

# true  = an alerted entry is recorded as filled at the alerted credit
# false = you confirm manually by editing state/positions.json
ASSUME_FILLED=true

# 1 = print alerts to stdout, touch no state, send nothing
DRY_RUN=
